{
  "name": "lomboksql",
  "version": "0.1.0",
  "description": "Universal SQL query compiler: one JSON AST to parameterized SQL for PostgreSQL, MySQL, SQLite and SQL Server. Part of the Lombok Ecosystem.",
  "license": "Apache-2.0 OR MIT",
  "author": "codinglombok",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codinglombok/LombokSQL.git",
    "directory": "typescript"
  },
  "homepage": "https://github.com/codinglombok/LombokSQL#readme",
  "bugs": "https://github.com/codinglombok/LombokSQL/issues",
  "keywords": [
    "sql",
    "query-builder",
    "postgres",
    "mysql",
    "sqlite",
    "mssql",
    "parameterized",
    "lombok-ecosystem"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"dist-test/test/*.test.js\"",
    "pretest": "tsc -p tsconfig.test.json",
    "prepack": "node -e \"for (const f of ['README.md','LICENSE-APACHE','LICENSE-MIT']) require('fs').copyFileSync('../'+f, f)\"",
    "postpack": "node -e \"for (const f of ['README.md','LICENSE-APACHE','LICENSE-MIT']) require('fs').rmSync(f,{force:true})\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}

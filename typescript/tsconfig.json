{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "outDir": "dist", "rootDir": "src", "declaration": true, "strict": true,
    "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true, "skipLibCheck": true, "lib": ["ES2022"], "types": []
  },
  "include": ["src"]
}
